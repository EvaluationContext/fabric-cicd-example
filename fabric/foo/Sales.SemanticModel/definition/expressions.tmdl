/// Direct Lake on SQL over the Sales lakehouse's SQL analytics endpoint.
/// Both arguments are literals for the DEV workspace and neither autobinds:
/// parameter.yml rewrites the host with $items.Lakehouse.Sales.$sqlendpoint
/// and the id with $items.Lakehouse.Sales.$sqlendpointid on the way in.
expression DatabaseQuery =
		let
		    database = Sql.Database("fazr2kwaq6cu7eggbo3jwhcjpa-fxamsxatkt2u5bl75airgogjba.datawarehouse.fabric.microsoft.com", "db350be1-b962-4567-b875-229eb67d1582")
		in
		    database
	lineageTag: a1000000-0000-4000-8000-00000000000a

	annotation PBI_IncludeFutureArtifacts = False

